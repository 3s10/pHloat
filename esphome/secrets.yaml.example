# Copy to secrets.yaml (gitignored) and fill in. Never commit the real file.
wifi_ssid: "your-ssid"
wifi_password: "your-wifi-password"
fallback_ap_password: "at-least-8-chars"
# 32-byte base64 key. Generate one at https://esphome.io/components/api/ or: openssl rand -base64 32
api_encryption_key: "REPLACE_ME"
ota_password: "REPLACE_ME"
# The pHloat server on the Tilt Pi, and the upload_secret from its config.json.
tiltpi_url: "http://192.168.1.50:5000/api/ph"
phloat_upload_secret: "REPLACE_ME"

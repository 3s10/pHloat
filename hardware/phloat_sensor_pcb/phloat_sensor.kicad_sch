		(property "Value" "SMA jack (probe)" (at 54.61 85.09 0) (effects (font (size 1.27 1.27)) (justify left)))
		(property "Footprint" "Connector_Coaxial:SMA_Amphenol_132289_EdgeMount" (at 50.80 83.82 0) (effects (font (size 1.27 1.27)) (hide yes)))
